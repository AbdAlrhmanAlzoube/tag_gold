# ===========================================
# Gold Certificates — Production Environment
# انسخ هذا الملف إلى .env.prod وعدّل القيم
# cp .env.prod.example .env.prod
# ===========================================

# Domain (بدون / في النهاية)
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

APP_NAME="Gold Certificate Verification"
APP_BRAND_NAME="TAJ JEWELRY"
APP_BRAND_NAME_AR="تاج للمجوهرات"

# مهم: ولّد مفتاحاً قوياً على السيرفر:
# docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=

APP_ENV=production
APP_DEBUG=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=error

# Database — غيّر كلمات المرور فوراً
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_STRONG
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gold_certificates
DB_USERNAME=gold
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_STRONG

# أول تشغيل فقط: true لإنشاء الأدمن والشهادات التجريبية
# بعد أول تشغيل ناجح غيّرها إلى false
RUN_SEEDERS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Admin الافتراضي (من الـ seeder) — غيّر كلمة المرور بعد الدخول:
# Email: admin@tajjewelry.com
# Password: admin123
