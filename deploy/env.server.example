# إعداد السيرفر — فرونت وباك على دومينين منفصلين
# انسخ إلى: /var/www/html/tag_gold/backend/.env

APP_NAME="Gold Certificate Verification"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Backend domain
APP_URL=https://back.taj-jeweiry.abdulrahem-alzoubi.cloud

# Frontend domain
FRONTEND_URL=https://taj-jeweiry.abdulrahem-alzoubi.cloud

APP_BRAND_NAME="TAJ JEWELRY"
APP_BRAND_NAME_AR="تاج للمجوهرات"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tag_gold
DB_USERNAME=tag_gold
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
